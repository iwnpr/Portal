{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "GitLabLdap": {
    "ServerUrl": "ldap://gitlab.example.com",
    "Port": 389,
    "UseSsl": true,
    "BaseDn": "dc=example,dc=com",
    "UserDnPattern": "uid={0},ou=users,dc=example,dc=com",
    "GroupSearchBase": "ou=groups,dc=example,dc=com",
    "DisplayNameAttribute": "displayName",
    "EmailAttribute": "mail",
    "DefaultRole": "User",
    "GroupRoleMappings": {
      "gitlab-admins": "Administrator",
      "gitlab-developers": "Developer",
      "gitlab-auditors": "Auditor"
    }
  }
}
