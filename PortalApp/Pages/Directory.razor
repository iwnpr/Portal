@page "/directory"
@attribute [Authorize]
@inject IOptionsSnapshot<UserDirectoryOptions> DirectoryOptions

<PageTitle>Справочник сотрудников</PageTitle>

<div class="page-header">
    <h2>Справочник сотрудников</h2>
    <p class="text-muted">Информация о командах, ролях и контактах.</p>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var employee in DirectoryOptions.Value.Users.OrderBy(u => u.DisplayName))
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@employee.DisplayName</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@employee.Department</h6>
                    <p class="mb-2"><strong>Логин:</strong> @employee.Username</p>
                    <div>
                        <strong>Роли:</strong>
                        @if (employee.Roles.Count == 0)
                        {
                            <span class="badge bg-secondary">Нет назначенных ролей</span>
                        }
                        else
                        {
                            foreach (var role in employee.Roles)
                            {
                                <span class="badge bg-info me-1">@role</span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
